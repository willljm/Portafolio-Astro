---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Portafolio de Wildeiner Meza A. Hecho con Astro, React y Tailwind." } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="shortcut icon" href="public/logo-de-will.png" type="image/png">
    <link 
      rel="preload" 
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" 
      as="style"
    >
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <title>{title}</title>
    <style is:global>
      * {
        -webkit-font-smoothing: antialiased;
      }

      html {
        scroll-behavior: smooth;
        scroll-padding-top: 5rem;
      }

      body {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
    </style>
  </head>
  <body class="bg-gradient-to-br from-purple-950 via-black to-black min-h-screen font-poppins bg-white text-gray-900">
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --accent: 136, 58, 234;
    --accent-light: 224, 204, 250;
    --accent-dark: 49, 10, 101;
  }
  

  body {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }
</style>